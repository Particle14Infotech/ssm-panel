{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint/eslint-plugin"],
  "extends": [],
  "root": true,
  "env": {
    "node": true,
    "jest": true
  },
  "ignorePatterns": [".eslintrc.js", "dist"],
  "rules": {},
  "overrides": [
    {
      "files": ["src/modules/packages/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Math.random is banned in packages module to guarantee deterministic schedule generation."
          }
        ]
      }
    }
  ]
}
