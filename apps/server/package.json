{
  "name": "@smm/server",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node --transpile-only src/main.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "export:openapi": "ts-node --transpile-only scripts/export-openapi.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@smm/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.test\\.ts$",
    "testTimeout": 30000,
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "target": "ES2022",
            "module": "commonjs",
            "moduleResolution": "node",
            "esModuleInterop": true
          }
        }
      ]
    }
  }
}
