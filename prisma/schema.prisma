datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  RESELLER
  SUPPORT
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELLED
  FAILED
  REFUNDED
}

enum TransactionType {
  DEPOSIT
  ORDER_CHARGE
  REFUND
  ADMIN_ADJUST
  BONUS
  COUPON
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             Role      @default(CUSTOMER)
  tier             String    @default("BRONZE")
  apiKeyHash       String?   @unique
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wallet    Wallet?
  orders    Order[]
  refunds   Refund[]
  tickets   Ticket[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([email, isDeleted])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId, isRevoked])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Balance in integer paise or decimal(12, 2)
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  currency  String   @default("INR")
  updatedAt DateTime @updatedAt

  ledger LedgerEntry[]

  @@index([userId])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  walletId       String
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Decimal         @db.Decimal(12, 2)
  type           TransactionType
  orderId        String?
  referenceId    String?         @unique
  idempotencyKey String?
  description    String?
  createdAt      DateTime        @default(now())

  // Enforces at most ONE refund entry per order
  @@unique([orderId, type], name: "unique_refund_per_order")
  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([type])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@index([slug])
}

model Service {
  id                String    @id @default(uuid())
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  name              String
  description       String?
  platform          String // INSTAGRAM, YOUTUBE, TIKTOK, etc.
  ratePer1000       Decimal   @db.Decimal(10, 2)
  minQty            Int
  maxQty            Int
  avgTime           String?
  providerId        String?
  provider          Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerServiceId String?
  refillable        Boolean   @default(false)
  cancellable       Boolean   @default(false)
  active            Boolean   @default(true)
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders Order[]

  @@index([platform, categoryId, status])
  @@index([isDeleted])
  @@index([providerId])
}

model Provider {
  id              String    @id @default(uuid())
  name            String
  apiUrl          String
  apiKeyEncrypted String
  balance         Decimal   @default(0.00) @db.Decimal(12, 2)
  currency        String    @default("INR")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  services Service[]
  orders   Order[]

  @@index([active])
}

model Order {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  serviceId       String
  service         Service              @relation(fields: [serviceId], references: [id])
  target          String
  quantity        Int
  charge          Decimal              @db.Decimal(10, 2)
  status          OrderStatus          @default(PENDING)
  providerId      String?
  provider        Provider?            @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerOrderId String?
  startCount      Int                  @default(0)
  remains         Int                  @default(0)
  idempotencyKey  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  history OrderStatusHistory[]
  refunds Refund[]

  @@unique([userId, idempotencyKey], name: "unique_order_idempotency_per_user")
  @@index([userId, status, createdAt])
  @@index([providerId, status])
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     OrderStatus
  startCount Int?
  remains    Int?
  notes      String?
  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Refund {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  gatewayOrderId String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  bonusAmount    Decimal       @default(0.00) @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  method         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@index([gatewayOrderId])
}

model OutboxEvent {
  id          String       @id @default(uuid())
  aggregate   String // ORDER, WALLET, PROVIDER
  eventType   String // ORDER_CREATED, REFUND_REQUESTED
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

model Ticket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  status    String   @default("OPEN") // OPEN, PENDING, ANSWERED, CLOSED
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([userId, status])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  message   String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
