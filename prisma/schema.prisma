datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  CUSTOMER
  RESELLER
  SUPPORT
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELLED
  FAILED
  REFUNDED
}

enum TransactionType {
  DEPOSIT
  ORDER_CHARGE
  REFUND
  ADMIN_ADJUST
  BONUS
  COUPON
  PACKAGE_PURCHASE
  PACKAGE_REFUND
}

enum PackageStatus {
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PackageRuleKind {
  POST_TRIGGERED
  TIME_DRIP
}

enum ExecutionSource {
  MEDIA
  SCHEDULE
}

enum PackageExecutionStatus {
  DETECTED
  SCHEDULED
  DISPATCHED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  STALLED
  SKIPPED_PAUSED
  SKIPPED_QUOTA
  SKIPPED_TYPE
  SKIPPED_DELETED
  SKIPPED_LIMIT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  BOUNCED
  COMPLAINED
}

enum DripMode {
  NONE
  NATIVE
  MANAGED
}

enum OrderRunStatus {
  SCHEDULED
  DISPATCHING
  UNCERTAIN
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELED
}

enum ServiceKind {
  LIKES
  VIEWS
  FOLLOWERS
  SUBSCRIBERS
  COMMENTS
  REACH
  IMPRESSIONS
  SHARES
  SAVES
  OTHER
}

enum PackagePricingMode {
  FIXED
  COMPUTED
}

enum PackageMode {
  LEGACY
  TEMPLATE
  CUSTOMIZED
  CUSTOM
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  passwordHash               String
  name                       String
  role                       Role      @default(CUSTOMER)
  tier                       String    @default("BRONZE")
  apiKeyHash                 String?   @unique
  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  twoFactorSecret            String?
  twoFactorEnabled           Boolean   @default(false)
  isDeleted                  Boolean   @default(false)
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  themePreference            String?   @default("system")

  wallet    Wallet?
  orders    Order[]
  refunds   Refund[]
  tickets   Ticket[]
  sessions  Session[]
  auditLogs AuditLog[]
  emailLogs EmailLog[]
  favorites Favorite[]
  drafts    PackageDraft[]
  packages  Package[]

  @@index([email, isDeleted])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId, isRevoked])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Balance in integer paise or decimal(12, 2)
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  currency  String   @default("INR")
  updatedAt DateTime @updatedAt

  ledger LedgerEntry[]

  @@index([userId])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  walletId       String
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Decimal         @db.Decimal(12, 2)
  type           TransactionType
  orderId        String?
  referenceId    String?         @unique
  idempotencyKey String?
  description    String?
  createdAt      DateTime        @default(now())

  // Enforces at most ONE refund entry per order
  @@unique([orderId, type], name: "unique_refund_per_order")
  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([type])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@index([slug])
}

model Service {
  id                       String                @id @default(uuid())
  categoryId               String
  category                 Category              @relation(fields: [categoryId], references: [id])
  name                     String
  displayName              String?
  description              String?
  platform                 String // INSTAGRAM, YOUTUBE, TIKTOK, etc.
  ratePer1000              Decimal               @db.Decimal(10, 2)
  minQty                   Int
  maxQty                   Int
  avgTime                  String?
  providerId               String?
  provider                 Provider?             @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerServiceId        String?
  routingMode              String                @default("MANUAL") // MANUAL, AUTO_FAILOVER
  backupProviderId         String?
  backupProviderServiceId  String?
  refillable               Boolean               @default(false)
  cancellable              Boolean               @default(false)
  dripFeedSupported        Boolean               @default(false)
  allowManagedDrip         Boolean               @default(false)
  rawMeta                  Json?
  dripFeedMinRuns          Int?
  dripFeedMaxRuns          Int?
  dripFeedMinInterval      Int?
  dripFeedMaxInterval      Int?
  serviceType              String                @default("DEFAULT")
  kind                     ServiceKind           @default(OTHER)
  geoCountry               String?
  geoRegion                String?
  templateItems            PackageTemplateItem[] // DEFAULT, CUSTOM_COMMENTS, NEEDS_REVIEW
  linkType                 String                @default("POST_OR_REEL") // PROFILE, POST_OR_REEL, CHANNEL, CUSTOM
  providerCostPer1k        Decimal?              @db.Decimal(12, 4)
  providerCostCurrency     String?               @default("USD")
  costINR                  Decimal?              @db.Decimal(12, 2)
  marginPercentOverride    Decimal?              @db.Decimal(5, 2)
  fixedSellingRateOverride Decimal?              @db.Decimal(10, 2)
  priceBelowCost           Boolean               @default(false)
  priceChangeStatus        String                @default("NORMAL") // NORMAL, PENDING_APPROVAL, BELOW_COST
  packageEligible          Boolean               @default(false)
  active                   Boolean               @default(true)
  status                   String                @default("ACTIVE") // ACTIVE, INACTIVE
  isDeleted                Boolean               @default(false)
  deletedAt                DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  orders              Order[]
  priceHistory        ServicePriceHistory[]
  pendingPriceChanges PendingPriceChange[]
  favorites           Favorite[]
  drafts              PackageDraft[]
  packageRules        PackageRule[]

  @@index([platform, categoryId, status])
  @@index([isDeleted, active, platform])
  @@index([isDeleted, active, categoryId])
  @@index([isDeleted, active, ratePer1000])
  @@index([isDeleted])
  @@index([providerId])
}

model Provider {
  id                        String    @id @default(uuid())
  name                      String
  apiUrl                    String
  apiKeyEncrypted           String
  balance                   Decimal   @default(0.00) @db.Decimal(12, 2)
  currency                  String    @default("INR")
  active                    Boolean   @default(true)
  consecutiveStatusFailures Int       @default(0)
  lastStatusCheckAt         DateTime?
  lastStatusCheckError      String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  services Service[]
  orders   Order[]

  @@index([active])
}

model Order {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  serviceId          String
  service            Service           @relation(fields: [serviceId], references: [id])
  target             String
  quantity           Int
  isDripFeed         Boolean           @default(false)
  dripMode           DripMode          @default(NONE)
  runs               Int?
  intervalMinutes    Int?
  quantityPerRun     Int?
  totalQuantity      Int               @default(0)
  charge             Decimal           @db.Decimal(10, 2)
  status             OrderStatus       @default(PENDING)
  providerId         String?
  provider           Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerOrderId    String?
  startCount         Int               @default(0)
  remains            Int               @default(0)
  idempotencyKey     String?
  packageExecutionId String?           @unique
  packageExecution   PackageExecution? @relation("PackageExecutionOrder", fields: [packageExecutionId], references: [id], onDelete: SetNull)
  isPrepaid          Boolean           @default(false)

  // Financial Snapshot Fields
  sellRatePer1k         Decimal  @default(0.00) @db.Decimal(10, 2)
  costRatePer1k         Decimal  @default(0.00) @db.Decimal(10, 2)
  fxRateUsed            Decimal  @default(1.0000) @db.Decimal(10, 4)
  providerCurrency      String   @default("INR")
  dripSurchargePercent  Decimal  @default(0.00) @db.Decimal(5, 2)
  estimatedProviderCost Decimal  @default(0.00) @db.Decimal(12, 2)
  estimatedGrossProfit  Decimal  @default(0.00) @db.Decimal(12, 2)
  paymentFeeEstimate    Decimal  @default(0.00) @db.Decimal(12, 2)
  estimatedNetProfit    Decimal  @default(0.00) @db.Decimal(12, 2)
  actualProviderCost    Decimal? @db.Decimal(12, 2)
  actualProfit          Decimal? @db.Decimal(12, 2)
  costUnknown           Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history        OrderStatusHistory[]
  refunds        Refund[]
  providerEvents OrderProviderEvent[]
  runsList       OrderRun[]

  @@unique([userId, idempotencyKey], name: "unique_order_idempotency_per_user")
  @@index([userId, status, createdAt])
  @@index([providerId, status])
}

model OrderRun {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runIndex        Int
  quantity        Int
  scheduledAt     DateTime
  status          OrderRunStatus @default(SCHEDULED)
  providerOrderId String?
  attempts        Int            @default(0)
  nextAttemptAt   DateTime?
  lastError       String?
  delivered       Int            @default(0)
  chargeShare     Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([orderId, runIndex])
  @@index([status, scheduledAt])
  @@index([orderId])
  @@index([providerOrderId])
}

model OrderProviderEvent {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerId      String?
  action          String
  requestPayload  Json
  responsePayload Json?
  error           String?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     OrderStatus
  startCount Int?
  remains    Int?
  notes      String?
  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Refund {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([packageId, reason])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([packageId])
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  gatewayOrderId String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  bonusAmount    Decimal       @default(0.00) @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  method         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@index([gatewayOrderId])
}

model OutboxEvent {
  id          String       @id @default(uuid())
  aggregate   String // ORDER, WALLET, PROVIDER
  eventType   String // ORDER_CREATED, REFUND_REQUESTED
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

model Ticket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  status    String   @default("OPEN") // OPEN, PENDING, ANSWERED, CLOSED
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([userId, status])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  message   String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model EmailLog {
  id                String      @id @default(uuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  to                String
  type              String // VERIFY_EMAIL, PASSWORD_RESET, WELCOME, PAYMENT_RECEIPT, ORDER_REFUND, SUPPORT_REPLY
  subject           String
  status            EmailStatus @default(PENDING)
  providerMessageId String?
  idempotencyKey    String?     @unique
  error             String?
  attempts          Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([to, status])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model EmailSuppression {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String // BOUNCE, COMPLAINT
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailDailyCounter {
  date      String   @id // YYYY-MM-DD
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model ServicePriceHistory {
  id          String   @id @default(uuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  oldCostRate Decimal? @db.Decimal(12, 4)
  newCostRate Decimal? @db.Decimal(12, 4)
  oldSellRate Decimal? @db.Decimal(10, 2)
  newSellRate Decimal? @db.Decimal(10, 2)
  reason      String?
  changedBy   String?
  createdAt   DateTime @default(now())

  @@index([serviceId, createdAt])
}

model PendingPriceChange {
  id               String   @id @default(uuid())
  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  oldCostRate      Decimal? @db.Decimal(12, 4)
  newCostRate      Decimal? @db.Decimal(12, 4)
  oldSellRate      Decimal? @db.Decimal(10, 2)
  proposedSellRate Decimal? @db.Decimal(10, 2)
  percentageChange Decimal? @db.Decimal(5, 2)
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([serviceId, status])
}

model Favorite {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customName      String?
  targetUrl       String
  defaultQuantity Int
  isDripFeed      Boolean  @default(false)
  dripRuns        Int?
  dripInterval    Int?
  comments        String?
  config          Json?
  configHash      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, serviceId, targetUrl])
  @@index([userId, createdAt])
}

model SuggestionDismissal {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  targetUrl String
  createdAt DateTime @default(now())

  @@unique([userId, serviceId, targetUrl])
  @@index([userId])
}

model PlatformConfig {
  id                   String   @id @default(uuid())
  platform             String   @unique
  displayName          String
  handleRegex          String
  handleMaxLength      Int      @default(64)
  hostAllowlist        String[] @default([])
  pathPattern          String
  mediaKeyExtractor    String
  urlContainsHandle    Boolean  @default(false)
  eligibleRuleKinds    String[] @default(["POST_TRIGGERED", "TIME_DRIP"])
  followersIntervals   Int[]    @default([1, 2, 4, 8, 12, 24])
  minGapMinutes        Int      @default(15)
  maxRunsPerPost       Int      @default(10)
  defaultWindowMinutes Int      @default(180)
  limits               Json     @default("{}")
  labels               Json?
  dripIntervals        Int[]    @default([1, 2, 4, 8, 12, 24])
  durationChips        Int[]    @default([1, 5, 7, 10, 14, 20, 25, 30])
  maxExtraHours        Int      @default(24)
  enabledTabs          String[] @default(["SINGLE", "CUSTOM_DRIP", "COMBOS", "AUTOPILOT"])
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PlatformHandleBlocklist {
  id        String   @id @default(uuid())
  platform  String
  handle    String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([platform, handle])
  @@index([platform, handle])
}

model Package {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform           String           @default("INSTAGRAM")
  handle             String
  timezone           String           @default("UTC")
  kind               PackageRuleKind?
  status             PackageStatus    @default(ACTIVE)
  startAt            DateTime         @default(now())
  endAt              DateTime
  pausedDays         Int              @default(0)
  mode               PackageMode      @default(LEGACY)
  templateTierId     String?
  priceSnapshot      Json?
  allocationSnapshot Json?
  slots              PackageSlot[]
  reserveTotal       Decimal          @db.Decimal(12, 2)
  idempotencyKey     String?
  rescheduleCount    Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  rules      PackageRule[]
  triggers   PackageTrigger[]
  executions PackageExecution[]
  refunds    Refund[]
  events     PackageEvent[]

  @@unique([userId, idempotencyKey], name: "unique_package_idempotency_per_user")
  @@index([userId, status, createdAt])
  @@index([platform, handle, status])
  @@index([status, endAt])
}

model PackageRule {
  id                String          @id @default(uuid())
  packageId         String
  package           Package         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  kind              PackageRuleKind
  serviceId         String
  service           Service         @relation(fields: [serviceId], references: [id])
  quantityPerPost   Int             @default(0)
  mediaTypes        String[]        @default([])
  delayMinutes      Int             @default(0)
  deliveryWindowMin Int             @default(0)
  maxPosts          Int             @default(1)
  deliveryWindow    Json?
  maxPerDay         Int             @default(0)
  minSpacingMin     Int             @default(0)
  usedCount         Int             @default(0)
  unitCharge        Decimal         @db.Decimal(10, 2)
  rateSnapshot      Decimal         @db.Decimal(10, 2)
  reserve           Decimal         @db.Decimal(12, 2)
  allocatedShare    Decimal?        @db.Decimal(12, 2)
  allocationBp      Int?            @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  executions PackageExecution[]

  @@index([packageId])
  @@index([serviceId])
}

model PackageTrigger {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  mediaKey  String
  targetUrl String
  createdAt DateTime @default(now())

  executions PackageExecution[]

  @@unique([packageId, mediaKey])
  @@index([packageId])
}

model PackageExecution {
  id                String                 @id @default(uuid())
  packageId         String
  package           Package                @relation(fields: [packageId], references: [id], onDelete: Cascade)
  ruleId            String
  rule              PackageRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggerId         String?
  trigger           PackageTrigger?        @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  mediaKey          String?
  targetUrl         String?
  source            ExecutionSource        @default(SCHEDULE)
  seq               Int                    @default(1)
  quantity          Int
  remainingQuantity Int                    @default(0)
  allocatedCharge   Decimal                @db.Decimal(10, 2)
  plannedAt         DateTime?
  executeAt         DateTime
  dispatchedAt      DateTime?
  status            PackageExecutionStatus @default(SCHEDULED)
  slotId            String?
  slot              PackageSlot?           @relation(fields: [slotId], references: [id], onDelete: SetNull)
  orderId           String?                @unique
  order             Order?                 @relation("PackageExecutionOrder")
  skipReason        String?
  attempts          Int                    @default(0)
  nextAttemptAt     DateTime?
  lastError         String?
  lastErrorAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([packageId, mediaKey, seq], name: "unique_package_media_seq")
  @@index([status, executeAt])
  @@index([packageId])
  @@index([ruleId])
}

model PackageEvent {
  id          String   @id @default(uuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  eventType   String
  actor       String
  reason      String?
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now())

  @@index([packageId])
  @@index([createdAt])
}

model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId], name: "unique_provider_event")
  @@index([provider, eventId])
}

model ProcessedIdempotencyKey {
  id             String   @id @default(uuid())
  key            String   @unique
  userId         String?
  action         String
  responseStatus Int      @default(200)
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@index([key])
  @@index([userId, action])
}

model PackageTemplate {
  id           String             @id @default(uuid())
  platform     String             @default("INSTAGRAM")
  slug         String             @unique
  name         String
  description  String?
  badge        String?
  pricingMode  PackagePricingMode @default(FIXED)
  active       Boolean            @default(true)
  archived     Boolean            @default(false)
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tiers PackageTemplateTier[]

  @@index([platform, active])
}

model PackageTemplateTier {
  id           String          @id @default(uuid())
  templateId   String
  template     PackageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version      Int             @default(1)
  name         String
  price        Decimal         @db.Decimal(12, 2)
  durationDays Int             @default(7)
  soldCount    Int             @default(0)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items PackageTemplateItem[]
  sales TemplateDailySales[]

  @@unique([templateId, version, name])
}

model PackageTemplateItem {
  id           String              @id @default(uuid())
  tierId       String
  tier         PackageTemplateTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service             @relation(fields: [serviceId], references: [id])
  quantity     Int
  kind         ServiceKind         @default(OTHER)
  allocationBp Int                 @default(0)
  displayOrder Int                 @default(0)

  @@index([tierId])
  @@index([serviceId])
}

model PackageSlot {
  id             String    @id @default(uuid())
  packageId      String
  package        Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  slotNumber     Int       @default(1)
  targetUrl      String?
  mediaKey       String?
  status         String    @default("AVAILABLE")
  linkSlotsUsed  Int       @default(0)
  linkSlotsTotal Int       @default(1)
  swapsUsed      Int       @default(0)
  maxSwaps       Int       @default(2)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  executions PackageExecution[]

  @@unique([packageId, slotNumber])
  @@unique([packageId, mediaKey])
  @@index([packageId, status])
}

model PackageDraft {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tab       String
  platform  String   @default("INSTAGRAM")
  stateJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?

  @@unique([userId, tab])
}

model TemplateDailySales {
  id        String              @id @default(uuid())
  tierId    String
  tier      PackageTemplateTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  date      String
  count     Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([tierId, date])
}

model PricingSettings {
  id               String   @id @default(uuid())
  marginFloor      Decimal  @default(0.15) @db.Decimal(5, 4)
  defaultMarkup    Decimal  @default(0.30) @db.Decimal(5, 4)
  roundingDecimals Int      @default(2)
  cancellationFee  Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
