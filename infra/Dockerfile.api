FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS builder
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @smm/contracts build
RUN pnpm --filter @smm/api build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app ./
RUN mkdir -p /app/node_modules/@smm /app/apps/api/node_modules/@smm && \
    ln -sf /app/packages/contracts /app/node_modules/@smm/contracts && \
    ln -sf /app/packages/contracts /app/apps/api/node_modules/@smm/contracts

EXPOSE 4000
CMD ["node", "apps/api/dist/main.js"]
