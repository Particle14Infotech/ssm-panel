# ==============================================================================
# SMM PANEL ENVIRONMENT SPECIFICATION
# All placeholders MUST start with REPLACE_ME_<NAME>
# In production, the system strictly refuses to boot if mvp-live variables are placeholders.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
BRAND_NAME=SMM PANEL

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# Managed PostgreSQL connection string. Dev and Test must use separate DBs!
# ------------------------------------------------------------------------------
DATABASE_URL=REPLACE_ME_DATABASE_URL
# Example: postgresql://smm_user:strongpassword@localhost:5432/smm_db?schema=public

# ------------------------------------------------------------------------------
# 2. MESSAGE BROKER & CACHE (Redis)
# Redis instance used for BullMQ workers and distributed locks.
# Can specify full connection string via REDIS_URL or individual host/port.
# ------------------------------------------------------------------------------
REDIS_URL=REPLACE_ME_REDIS_URL
# Example: redis://default:password@redis.railway.internal:6379
REDIS_HOST=REPLACE_ME_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

# Public Web / Frontend URLs
FRONTEND_URL=https://web-production.up.railway.app
NEXT_PUBLIC_API_URL=https://smm-production.up.railway.app/api/v1
NEXT_PUBLIC_SITE_NAME="SMM Panel"

# Admin Initial Credentials
ADMIN_EMAIL=admin@smmpanel.internal
ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD

# ------------------------------------------------------------------------------
# 3. SECURITY KEYS & ENCRYPTION
# Generate secrets using the command provided in each comment.
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME_JWT_ACCESS_SECRET
# Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=REPLACE_ME_JWT_REFRESH_SECRET
# Generate with: openssl rand -base64 32
PASSWORD_PEPPER=REPLACE_ME_PASSWORD_PEPPER
# Generate with: openssl rand -hex 32 (32 bytes AES-256-GCM encryption key for Provider credentials)
PROVIDER_KEY_SECRET=REPLACE_ME_PROVIDER_KEY_SECRET
PROVIDER_KEY_ENCRYPTION_KEY=REPLACE_ME_PROVIDER_KEY_ENCRYPTION_KEY
# Generate with: openssl rand -base64 32
COOKIE_SECRET=REPLACE_ME_COOKIE_SECRET

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay & Simulated)
# PAYMENT_PROVIDER: 'simulated' | 'razorpay'
# In production, PAYMENT_PROVIDER=simulated requires ALLOW_SIMULATED_PAYMENTS=true
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=false
RAZORPAY_KEY_ID=REPLACE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_ME_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_RAZORPAY_WEBHOOK_SECRET
PAYMENTS_MODE=live

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (SMTP)
# Get credentials from SendGrid, Amazon SES, Brevo, or Postmark.
# In development, unset/placeholder logs emails safely to console.
# ------------------------------------------------------------------------------
SMTP_HOST=REPLACE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_ME_SMTP_USER
SMTP_PASS=REPLACE_ME_SMTP_PASS
SMTP_FROM="SMM PANEL Support <support@smmpanel.internal>"

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (S3-Compatible) [OPTIONAL]
# AWS S3, Cloudflare R2, or MinIO. Unset/placeholder uses Local Disk storage.
# ------------------------------------------------------------------------------
S3_BUCKET=REPLACE_ME_S3_BUCKET
S3_REGION=ap-south-1
S3_ACCESS_KEY=REPLACE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_ME_S3_SECRET_KEY
S3_ENDPOINT=

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & SECURITY (Sentry & Snyk) [OPTIONAL]
# Sentry DSNs from https://sentry.io/settings/projects/
# Snyk token for CI from https://app.snyk.io/account
# ------------------------------------------------------------------------------
SENTRY_DSN=REPLACE_ME_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=REPLACE_ME_NEXT_PUBLIC_SENTRY_DSN
SNYK_TOKEN=REPLACE_ME_SNYK_TOKEN

# ------------------------------------------------------------------------------
# 8. BACKUP & ARCHIVAL [OPTIONAL]
# Key for pg_dump snapshot encryption: openssl rand -hex 32
# ------------------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY=REPLACE_ME_BACKUP_ENCRYPTION_KEY
BACKUP_S3_BUCKET=REPLACE_ME_BACKUP_S3_BUCKET

# ------------------------------------------------------------------------------
# 9. BACKGROUND WORKER & FEATURE FLAGS
# Set to false on Web/API instances to strictly isolate background queue consumption.
# ------------------------------------------------------------------------------
WORKER_ENABLED=true
RESELLER_FEATURE_FLAG=false
SMS_NOTIFICATIONS_FLAG=false
OTEL_FLAG=false
DATA_ARCHIVAL_FLAG=false
