# Application
NODE_ENV=development
BRAND_NAME=AETHER_SMM
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://smm_user:smm_password@localhost:5432/smm_db?schema=public"

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Secrets
JWT_ACCESS_SECRET="smm_dev_access_secret_key_minimum_32_characters_long_12345"
JWT_REFRESH_SECRET="smm_dev_refresh_secret_key_minimum_32_characters_long_12345"
PASSWORD_PEPPER="smm_super_secure_pepper_seed_12345"
PROVIDER_KEY_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Observability (Sentry / OpenTelemetry)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
