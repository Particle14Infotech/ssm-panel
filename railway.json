{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @smm/contracts build && pnpm exec prisma generate && pnpm --filter @smm/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @smm/api start:prod",
    "preDeployCommand": "pnpm exec prisma db push",
    "healthcheckPath": "/api/v1/health/live",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
