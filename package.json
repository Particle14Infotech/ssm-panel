{
  "name": "smm-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @smm/web dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:all": "pnpm --filter @smm/api test:all",
    "test:pg": "pnpm --filter @smm/api test:pg",
    "test:packages": "pnpm --filter @smm/api test:packages",
    "test:security-package": "pnpm --filter @smm/api test:security-package",
    "check:externals": "node scripts/check-externals.js",
    "export:openapi": "pnpm --filter @smm/server export:openapi",
    "check:contracts": "node scripts/check-contract-diff.js",
    "check:emoji": "node scripts/check-emoji.mjs --fail",
    "verify:backend": "node scripts/verify-backend.js",
    "verify:security": "node scripts/security-gate.js",
    "check:copy": "node scripts/check-forbidden-words.js",
    "check:theme-contrast": "node scripts/check-theme-contrast.mjs",
    "check:theme-lint": "node scripts/theme-lint.mjs",
    "smoke": "node scripts/smoke.js",
    "e2e:prod": "node scripts/e2e-prod.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@prisma/client": "^5.22.0",
    "@types/ssh2": "^1.15.6",
    "@types/supertest": "^7.2.1",
    "ioredis-mock": "^8.13.1",
    "pg-mem": "^3.0.14",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "ssh2": "^1.17.0",
    "supertest": "^7.3.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
